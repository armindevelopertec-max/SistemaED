generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  nombre    String
  role      Role     @default(VISUALIZADOR)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Tramite {
  id                Int           @id @default(autoincrement())
  hojaRuta          String        @unique
  codigoRai         String        @unique
  nombreTramite     String
  nombreSolicitante String
  descripcion       String?
  fechaCreacion     DateTime      @default(now())
  fechaVencimiento  DateTime
  estado            EstadoTramite @default(PENDIENTE)
  observaciones     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  documentos        Documento[]

  @@index([hojaRuta])
  @@index([codigoRai])
  @@index([estado])
  @@map("tramites")
}

model Documento {
  id        Int      @id @default(autoincrement())
  nombre    String
  tipo      String
  rutaMinio String
  tamano    Int
  tramiteId Int
  createdAt DateTime @default(now())
  tramite   Tramite  @relation(fields: [tramiteId], references: [id], onDelete: Cascade)

  @@map("documentos")
}

enum Role {
  ADMINISTRADOR
  VISUALIZADOR
}

enum EstadoTramite {
  VIGENTE
  POR_VENCER
  VENCIDO
  PENDIENTE
}
